# ~/.config/systemd/user/instagram-autopilot.service — edit the two paths, then:
#   systemctl --user enable --now instagram-autopilot.timer
[Unit]
Description=Instagram autopilot tick

[Service]
Type=oneshot
Environment=IGAP_HOME=%h/.instagram-autopilot
Environment=IGAP_STORAGE=file
ExecStart=/usr/bin/node %h/instagram-autopilot-skill/cli/igap.mjs run
